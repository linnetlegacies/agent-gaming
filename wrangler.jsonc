{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arena-one",
  "compatibility_date": "2026-08-29",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
